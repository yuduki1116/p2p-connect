{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p2p_connect",
  "version": "0.3.0",
  "identifier": "dev.yuzuki.p2pconnect",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "p2p_connect", "width": 460, "height": 660 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
